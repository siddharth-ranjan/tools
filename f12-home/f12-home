#!/usr/bin/env bash
# f12-home -- report F12 as Home on keyboards that have no Home key.
#
# The mapping itself lives in f12-home.Xmodmap. `watch` keeps it applied; the
# other subcommands verify and toggle it without editing anything by hand.
set -uo pipefail

MAP="$HOME/.Xmodmap"
AUTOSTART="$HOME/.config/autostart/f12-home.desktop"
KEYCODE=96

# Stock X keymap value for keycode 96, used to undo the remap in-session.
F12_DEFAULT="F12 F12 F12 F12 F12 F12 XF86Switch_VT_12"

current() {
    # Prints the symbols currently bound to $KEYCODE, e.g. "Home Home Home".
    xmodmap -pke 2>/dev/null | awk -v k="$KEYCODE" '$2 == k { sub(/^keycode +[0-9]+ = /, ""); print }'
}

case "${1:-status}" in
    status)
        cur="$(current)"
        echo "keycode $KEYCODE = ${cur:-<unreadable>}"
        case "$cur" in
            Home*) echo "state:     active (F12 sends Home)" ;;
            F12*)  echo "state:     inactive (F12 is F12)" ;;
            *)     echo "state:     unknown" ;;
        esac
        echo "map file:  $MAP$([ -L "$MAP" ] && echo " -> $(readlink -f "$MAP")")"
        echo "autostart: $([ -e "$AUTOSTART" ] && echo present || echo missing)"
        echo "watcher:   $(pgrep -f 'f12-home watch' >/dev/null && echo running || echo 'not running')"
        ;;
    apply)
        # Idempotent: xmodmap replaces the binding rather than appending to it.
        [ -e "$MAP" ] || { echo "no $MAP -- run install.sh first" >&2; exit 1; }
        xmodmap "$MAP" || exit 1
        echo "applied: keycode $KEYCODE = $(current)"
        ;;
    watch)
        # Run from autostart. X hands every newly added keyboard the default
        # layout, which wipes the remap -- and Bluetooth headsets register as
        # keyboards (AVRCP media buttons), so connecting headphones silently
        # turned F12 back into F12. Reapply on every input-device add.
        #
        # This listens to udev device events only, never to keystrokes.
        # stdbuf is required: udevadm block-buffers into a pipe, so events would
        # stall until 4KB accumulated.
        [ -e "$MAP" ] || { echo "no $MAP -- run install.sh first" >&2; exit 1; }
        sleep 3   # Cinnamon loads its own keymap at login; apply after it.
        xmodmap "$MAP"
        stdbuf -oL udevadm monitor --udev --subsystem-match=input 2>/dev/null |
            while read -r line; do
                case "$line" in
                    *" add "*)
                        # One connect emits several events (input + event
                        # nodes) and X attaches the device slightly after udev
                        # reports it. Wait, drain the burst, apply once.
                        sleep 1
                        while read -r -t 0.5 _; do :; done
                        xmodmap "$MAP"
                        ;;
                esac
            done
        ;;
    off)
        # Restores F12 until the next device connects or login; `watch`
        # reapplies the remap then. Stop the watcher to keep F12 longer.
        xmodmap -e "keycode $KEYCODE = $F12_DEFAULT" || exit 1
        echo "restored: keycode $KEYCODE = $(current)"
        ;;
    *)
        echo "usage: f12-home {status|apply|watch|off}" >&2
        exit 1
        ;;
esac
